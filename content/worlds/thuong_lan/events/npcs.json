              "favor": -30,
              "affinity": 10
            },
            "stat.comprehension": 2
          }
        }
      },
      {
        "text": "Từ chối, coi như bạn bè",
        "result": {
          "text": "{npc} cười lớn, kéo ngươi đi uống rượu. Ơn chưa trả, tình đã sâu thêm.",
          "variants": [
            "{npc} bảo vậy thì nợ thêm, rồi rót rượu đầy chén. Hai người uống tới khuya.",
            "\"Bạn bè mà tính sổ thì còn gì là bạn.\" {npc} vỗ vai ngươi, mắt hơi đỏ."
